---
interface Props {
  src: string;
  poster?: string;
  title?: string;
  config?: Record<string, unknown>;
  class?: string;
}

const { src, poster, title, config, class: className } = Astro.props;
const VIDSTACK_VERSION = "1.12.13";
const PLAYERSTACK_VERSION = "0.1.0";
---

<!-- Vidstack styles (loaded once per page even if multiple Players are used) -->
<link
  rel="stylesheet"
  href={`https://cdn.jsdelivr.net/npm/vidstack@${VIDSTACK_VERSION}/player/styles/default/theme.css`}
/>
<link
  rel="stylesheet"
  href={`https://cdn.jsdelivr.net/npm/vidstack@${VIDSTACK_VERSION}/player/styles/default/layouts/video.css`}
/>

<!-- Playerstack bundle (auto-registers <player-stack>) -->
<script
  src={`https://cdn.jsdelivr.net/npm/playerstack@${PLAYERSTACK_VERSION}/dist/playerstack.min.js`}
  defer
  is:inline></script>

<player-stack
  src={src}
  poster={poster}
  title={title}
  data-config={config ? JSON.stringify(config) : undefined}
  class={className}
></player-stack>
