{
  "printWidth": 100,
  "tabWidth": 2,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "overrides": [
    { "files": "*.md", "options": { "printWidth": 80 } },
    { "files": "*.astro", "options": { "parser": "astro" } }
  ]
}
