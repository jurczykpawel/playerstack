{
  "name": "playerstack-monorepo",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/playground dev",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "test:watch": "bun run --filter '*' test:watch",
    "test:e2e": "playwright test",
    "typecheck": "bun run typecheck:core && bun run typecheck:plugins",
    "typecheck:core": "tsc --noEmit -p packages/core/tsconfig.json",
    "typecheck:plugins": "for d in packages/plugin-*; do tsc --noEmit -p \"$d/tsconfig.json\" || exit 1; done",
    "lint": "bun run typecheck && bun run format:check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,html,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,html,css}\""
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "happy-dom": "^20.0.0",
    "@playwright/test": "^1.50.0"
  },
  "overrides": {
    "hls.js": "1.6.16",
    "media-chrome": "4.19.2",
    "vimeo-video-element": "1.7.2"
  }
}
