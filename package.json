{
  "name": "playerstack-monorepo",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/playground dev",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "test:watch": "bun run --filter '*' test:watch",
    "test:e2e": "playwright test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,html,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,html,css}\""
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "happy-dom": "^20.0.0",
    "@playwright/test": "^1.50.0"
  }
}
