---
import Base from "../layouts/Base.astro";

const quickstart = `<script src="https://cdn.jsdelivr.net/npm/playerstack@0.1.0/dist/playerstack.min.js" defer></` + `script>

<player-stack
  src="https://youtu.be/dQw4w9WgXcQ"
  data-config='{"controls":{"accent":"#008aff"}}'>
</player-stack>`;
---

<Base title="Playerstack — embeddable video player">
  <main>
    <header class="hero">
      <h1>Playerstack</h1>
      <p class="lead">
        Embeddable video player. One script tag. YouTube, Vimeo, MP4, HLS. Brand it,
        add CTAs, gate emails — all via plugins. MIT.
      </p>
      <div class="cta-row">
        <a class="cta primary" href="/playground">Live playground →</a>
        <a class="cta" href="https://github.com/jurczykpawel/playerstack" target="_blank" rel="noreferrer">GitHub</a>
      </div>
    </header>

    <section>
      <h2>Quickstart</h2>
      <pre><code>{quickstart}</code></pre>
    </section>

    <section>
      <h2>What it does</h2>
      <ul>
        <li><strong>Sources auto-detect</strong> — paste a YouTube, Vimeo, MP4, or HLS URL, it just works.</li>
        <li><strong>Branding</strong> — color theme, custom poster, click-to-load (LCP + GDPR).</li>
        <li><strong>CTAs</strong> — overlay HTML at end of video, button with UTM, replay.</li>
        <li><strong>Autopreview</strong> — muted autoplay when in viewport, pause when out.</li>
        <li><strong>Plugin-first</strong> — every feature is a plugin you can swap or extend.</li>
      </ul>
    </section>

    <section>
      <h2>Why</h2>
      <p>
        Vidstack and Plyr are great engines for developers — no marketing layer.
        Presto Player has the marketing layer — only for WordPress. Playerstack is
        the modern, framework-agnostic combination of both.
      </p>
    </section>

    <footer>
      <p>MIT. Built on <a href="https://vidstack.io" target="_blank" rel="noreferrer">Vidstack</a>.</p>
    </footer>
  </main>
</Base>

<style>
  main { max-width: 920px; margin: 0 auto; padding: 64px 24px; }
  .hero { padding: 32px 0 48px; }
  h1 { font-size: 56px; margin: 0 0 8px; line-height: 1; }
  .lead { font-size: 19px; color: var(--muted); max-width: 640px; margin: 0 0 24px; }
  .cta-row { display: flex; gap: 12px; flex-wrap: wrap; }
  .cta {
    display: inline-block;
    padding: 12px 20px;
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    color: var(--fg);
    font-weight: 500;
  }
  .cta.primary { background: var(--accent); color: #fff; border-color: var(--accent); }
  section { padding: 32px 0; border-top: 1px solid var(--border); }
  section h2 { font-size: 24px; color: var(--accent); margin: 0 0 16px; }
  ul { margin: 0; padding-left: 20px; }
  li { margin: 8px 0; }
  footer { padding: 32px 0; border-top: 1px solid var(--border); color: var(--muted); }
</style>
