---
import "@fontsource-variable/inter";
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/jetbrains-mono";
import interFont from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2";
import displayFont from "@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2";
import Base from "../layouts/Base.astro";
import { en } from "../content/landing";

const c = en;

// Inline Lucide icons (stroke 1.75) — no emoji as icons (workspace rule).
const icon: Record<string, string> = {
  github:
    '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 .5 5 .5 5 .5c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 7.5c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  arrow:
    '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  copy:
    '<rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  plus: '<path d="M5 12h14"/><path d="M12 5v14"/>',
  megaphone:
    '<path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/>',
  grad:
    '<path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>',
  zap: '<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>',
  palette:
    '<circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.563-2.512 5.563-5.563C21.5 6.012 17.488 2 12 2z"/>',
  chart:
    '<path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>',
};

const groupIcon = ["megaphone", "grad", "zap", "palette", "chart"];
---

<Base title={c.meta.title} description={c.meta.description}>
  <Fragment slot="head">
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin="anonymous" />
  </Fragment>
  <script is:inline>document.documentElement.classList.add("js");</script>
  <a href="#main" class="skip">Skip to content</a>

  <header class="nav" id="nav">
    <div class="nav-inner">
      <a href="#top" class="brand" aria-label="Playerstack home">
        <span class="brand-dot" aria-hidden="true"></span>
        Playerstack
      </a>
      <nav class="nav-links" aria-label="Primary">
        {c.nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <a class="nav-gh" href={c.nav.github} target="_blank" rel="noreferrer" aria-label="Playerstack on GitHub">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon.github} />
        <span>GitHub</span>
      </a>
    </div>
  </header>

  <main id="main">
    <span id="top"></span>

    <!-- HERO -->
    <section class="hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="wrap hero-inner reveal">
        <p class="eyebrow">{c.hero.eyebrow}</p>
        <h1 class="hero-title">{c.hero.title}</h1>
        <p class="hero-lead">{c.hero.lead}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={c.hero.primary.href}>
            {c.hero.primary.label}
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon.arrow} />
          </a>
          <a class="btn btn-ghost" href={c.hero.secondary.href}>{c.hero.secondary.label}</a>
        </div>
        <button class="install" type="button" data-copy={c.hero.install} aria-label="Copy the embed script tag">
          <code>{c.hero.install}</code>
          <svg class="install-ico" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon.copy} />
        </button>
        <a class="install-note" href={c.hero.selfHost.href}>{c.hero.selfHost.label}</a>
      </div>
    </section>

    <!-- LIVING DEMO -->
    <section class="demo" id="living-demo">
      <div class="wrap">
        <header class="sec-head reveal">
          <p class="eyebrow">{c.livingDemo.eyebrow}</p>
          <h2>{c.livingDemo.title}</h2>
          <p class="sec-lead">{c.livingDemo.lead}</p>
        </header>

        <div class="demo-grid">
          <div class="demo-stage">
            <div class="stage-card">
              <div class="stage-bar" aria-hidden="true">
                <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                <span class="stage-url">{c.livingDemo.srcLabel}</span>
              </div>
              <div class="player-host" id="demo-host" aria-label="Live Playerstack demo"></div>
              <ol class="rail" id="demo-rail" aria-hidden="true">
                {c.livingDemo.steps.map((s, i) => (
                  <li data-i={i}><span>{s.label}</span></li>
                ))}
              </ol>
            </div>
          </div>

          <ol class="steps" id="demo-steps">
            {c.livingDemo.steps.map((s, i) => (
              <li class="step reveal" data-i={i} id={`step-${i}`}>
                <div class="step-head">
                  <span class="chip">{s.key}</span>
                  <h3>{s.title}</h3>
                </div>
                <p>{s.blurb}</p>
                <pre class="code" aria-label={`Configuration after enabling ${s.key}`}><code>{s.code.map((line) => (
                  <span class={`cl${line.add ? " add" : ""}`} style={`--ind:${line.indent ?? 0}`}>{line.text}</span>
                ))}</code></pre>
              </li>
            ))}
          </ol>
        </div>
        <p class="demo-closer reveal">{c.livingDemo.closer}</p>
        <p class="demo-credit reveal">
          {c.livingDemo.credit.prefix}
          <a href={c.livingDemo.credit.titleHref} rel="noopener">{c.livingDemo.credit.title}</a>,
          {c.livingDemo.credit.holder},
          <a href={c.livingDemo.credit.licenseHref} rel="noopener">{c.livingDemo.credit.license}</a>
        </p>
      </div>
    </section>

    <!-- SOURCES -->
    <section class="sources">
      <div class="wrap sec-narrow">
        <header class="sec-head reveal">
          <p class="eyebrow">{c.sources.eyebrow}</p>
          <h2>{c.sources.title}</h2>
          <p class="sec-lead">{c.sources.lead}</p>
        </header>
        <ul class="badges reveal">
          {c.sources.items.map((s, i) => (
            <li style={`--d:${i * 45}ms`}>{s}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- PLUGINS -->
    <section class="plugins" id="plugins">
      <div class="wrap">
        <header class="sec-head reveal">
          <p class="eyebrow">{c.plugins.eyebrow}</p>
          <h2>{c.plugins.title}</h2>
          <p class="sec-lead">{c.plugins.lead}</p>
        </header>
        {c.plugins.groups.map((g, gi) => (
          <div class="pgroup reveal">
            <div class="pgroup-label">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon[groupIcon[gi]]} />
              <span>{g.label}</span>
            </div>
            <div class="pgrid">
              {g.items.map((p) => (
                <article class="pcard">
                  <h3>{p.name}</h3>
                  <code class="pkg">@playerstack/plugin-{p.pkg}</code>
                  <p>{p.desc}</p>
                </article>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- WHY -->
    <section class="why">
      <div class="wrap">
        <header class="sec-head reveal">
          <p class="eyebrow">{c.why.eyebrow}</p>
          <h2>{c.why.title}</h2>
        </header>
        <div class="why-grid">
          {c.why.cards.map((card, i) => (
            <article class={`why-card reveal${i === 2 ? " highlight" : ""}`}>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- FRAMEWORKS -->
    <section class="frameworks" id="frameworks">
      <div class="wrap fw-grid">
        <div class="fw-text reveal">
          <p class="eyebrow">{c.frameworks.eyebrow}</p>
          <h2>{c.frameworks.title}</h2>
          <p class="sec-lead">{c.frameworks.lead}</p>
          <ul class="fw-chips">
            {c.frameworks.items.map((f) => <li>{f}</li>)}
          </ul>
        </div>
        <div class="fw-code reveal">
          <div class="stage-bar" aria-hidden="true">
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
            <span class="stage-url">index.html</span>
          </div>
          <pre class="code"><code>{c.frameworks.snippet}</code></pre>
          <button class="copy-snip" type="button" data-copy={c.frameworks.snippet}>
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon.copy} />
            <span>Copy</span>
          </button>
        </div>
      </div>
    </section>

    <!-- TRUST -->
    <section class="trust">
      <div class="wrap trust-row reveal">
        {c.trust.items.map((t) => (
          <div class="trust-item">
            <span class="trust-val">{t.value}</span>
            <span class="trust-lab">{t.label}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq">
      <div class="wrap sec-narrow">
        <header class="sec-head reveal">
          <p class="eyebrow">{c.faq.eyebrow}</p>
          <h2>{c.faq.title}</h2>
        </header>
        <div class="faq-list reveal">
          {c.faq.items.map((f) => (
            <details>
              <summary>
                <span>{f.q}</span>
                <svg class="faq-ico" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon.plus} />
              </summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="final">
      <div class="final-glow" aria-hidden="true"></div>
      <div class="wrap final-inner reveal">
        <p class="eyebrow">{c.finalCta.eyebrow}</p>
        <h2>{c.finalCta.title}</h2>
        <p class="sec-lead">{c.finalCta.lead}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={c.finalCta.primary.href}>
            {c.finalCta.primary.label}
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon.arrow} />
          </a>
          <a class="btn btn-ghost" href={c.finalCta.secondary.href}>{c.finalCta.secondary.label}</a>
          <a class="btn btn-ghost" href={c.finalCta.github} target="_blank" rel="noreferrer" aria-label="Playerstack on GitHub">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon.github} />
            GitHub
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Step configs for the Living Demo controller -->
  <script
    type="application/json"
    id="demo-config"
    set:html={JSON.stringify({
      src: "/demo.mp4",
      poster: "/demo-poster.webp",
      steps: c.livingDemo.steps.map((s) => ({ config: s.config, action: s.action ?? null })),
    })}
  />

  <script>
    // -------- Reveal on scroll (IntersectionObserver + CSS) --------
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const reveals = document.querySelectorAll<HTMLElement>(".reveal");
    if (reduce) {
      reveals.forEach((el) => el.classList.add("in"));
    } else {
      const ro = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              ro.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.15 },
      );
      reveals.forEach((el) => ro.observe(el));
    }

    // -------- Copy buttons --------
    document.querySelectorAll<HTMLElement>("[data-copy]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const text = btn.getAttribute("data-copy") ?? "";
        try {
          await navigator.clipboard.writeText(text);
          btn.classList.add("copied");
          setTimeout(() => btn.classList.remove("copied"), 1400);
        } catch {
          /* clipboard unavailable */
        }
      });
    });

    // -------- Living Demo controller --------
    type DemoStepCfg = { config: Record<string, unknown>; action: "end" | null };
    type DemoCfg = { src: string; poster: string; steps: DemoStepCfg[] };
    const cfgEl = document.getElementById("demo-config");
    const host = document.getElementById("demo-host");
    const stepEls = Array.from(document.querySelectorAll<HTMLElement>(".step"));
    const railEls = Array.from(document.querySelectorAll<HTMLElement>(".rail li"));

    // The 800 KB player bundle is the page's heaviest asset and the demo sits below
    // the fold, so load it lazily (when the demo nears the viewport, or on idle).
    let bundlePromise: Promise<void> | null = null;
    const loadBundle = () => {
      if (bundlePromise) return bundlePromise;
      bundlePromise = new Promise<void>((resolve, reject) => {
        if ((window as unknown as { Playerstack?: unknown }).Playerstack) return resolve();
        const s = document.createElement("script");
        s.src = "/playerstack.min.js";
        s.onload = () => resolve();
        s.onerror = () => reject(new Error("bundle failed"));
        document.head.appendChild(s);
      });
      return bundlePromise;
    };

    if (cfgEl && host) {
      const cfg = JSON.parse(cfgEl.textContent ?? "{}") as DemoCfg;
      let current = -1;

      // Drive event-only plugins (cta-end) into their visible state. The plugin listens
      // for `ended` on the media element; muted autoplay is unreliable, so once the video
      // is ready we seek to the last frame and dispatch `ended` to render the end card.
      const driveToEnd = (el: HTMLElement) => {
        let tries = 0;
        const tick = () => {
          const v = el.querySelector<HTMLVideoElement>("video");
          if (!v) {
            if (tries++ < 40) requestAnimationFrame(tick);
            return;
          }
          const fire = () => {
            try {
              v.muted = true;
              if (isFinite(v.duration) && v.duration > 0) v.currentTime = Math.max(0, v.duration - 0.05);
            } catch {
              /* ignore */
            }
            v.dispatchEvent(new Event("ended"));
          };
          // The media element is appended before plugins finish initializing, so
          // re-fire `ended` a few times until the cta-end listener is attached and
          // its overlay appears.
          let n = 0;
          const id = setInterval(() => {
            fire();
            if (++n >= 8 || el.querySelector(".playerstack-cta")) {
              clearInterval(id);
            }
          }, 200);
        };
        tick();
      };

      const renderPlayer = (i: number) => {
        const step = cfg.steps[i] ?? { config: {}, action: null };
        host.innerHTML = "";
        const el = document.createElement("player-stack");
        // sources + branded-thumb validate absolute http(s) URLs, so resolve here
        el.setAttribute("src", new URL(cfg.src, location.origin).href);
        el.setAttribute("poster", new URL(cfg.poster, location.origin).href);
        el.setAttribute("title", "Playerstack");
        if (Object.keys(step.config).length > 0) {
          el.setAttribute("data-config", JSON.stringify(step.config));
        }
        host.appendChild(el);
        if (step.action === "end") driveToEnd(el);
      };

      const setActive = (i: number) => {
        if (i === current) return;
        current = i;
        stepEls.forEach((s, si) => s.classList.toggle("active", si === i));
        railEls.forEach((r, ri) => r.classList.toggle("on", ri <= i));
        renderPlayer(i);
      };

      const initDemo = () => {
        // Show a working player; default to the final, fully-loaded state.
        setActive(reduce ? cfg.steps.length - 1 : 0);
        if (!reduce) {
          const so = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                if (e.isIntersecting) {
                  setActive(Number((e.target as HTMLElement).dataset.i ?? "0"));
                }
              }
            },
            { rootMargin: "-50% 0px -50% 0px", threshold: 0 },
          );
          stepEls.forEach((s) => so.observe(s));
        }
      };

      let started = false;
      const start = () => {
        if (started) return;
        started = true;
        loadBundle().then(initDemo).catch(() => {});
      };

      // Observe the player host (well below the fold), not the whole section, so the
      // heavy bundle stays out of the initial paint and the hero text remains the LCP.
      const lo = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            lo.disconnect();
            start();
          }
        },
        { rootMargin: "150px 0px" },
      );
      lo.observe(host);
      // Reduced-motion users get no scroll morph, so load on idle to show the final state.
      if (reduce) {
        (window.requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 1500)))(() => start());
      }
    }

    // -------- Nav shadow on scroll --------
    const nav = document.getElementById("nav");
    if (nav) {
      const onScroll = () => nav.classList.toggle("scrolled", window.scrollY > 8);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    }
  </script>

  <style is:global>
    :root {
      --bg-base: #0a0c12;
      --bg-elevated: #10131c;
      --bg-floating: #161a26;
      --border-subtle: rgba(255, 255, 255, 0.07);
      --border-medium: rgba(255, 255, 255, 0.13);
      --text-primary: #f5f7fc;
      --text-secondary: #aab2c3;
      --text-tertiary: #8b93a5;
      --accent: #008aff;
      --accent-strong: #0a6fd6;
      --accent-hover: #2f9dff;
      --accent-muted: rgba(0, 138, 255, 0.14);
      --font-display: "Space Grotesk Variable", system-ui, sans-serif;
      --font-sans: "Inter Variable", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      --font-mono: "JetBrains Mono Variable", ui-monospace, "SF Mono", Menlo, monospace;
      --maxw: 1180px;
    }
    html { scroll-behavior: smooth; }
    body {
      background: var(--bg-base);
      color: var(--text-secondary);
      font-family: var(--font-sans);
      -webkit-font-smoothing: antialiased;
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
    }
  </style>

  <style>
    .wrap { max-width: var(--maxw); margin: 0 auto; padding-inline: 24px; }
    .sec-narrow { max-width: 880px; }

    .skip {
      position: absolute; left: -999px; top: 0; z-index: 200;
      background: var(--accent); color: #fff; padding: 10px 16px; border-radius: 0 0 8px 0;
    }
    .skip:focus { left: 0; }

    /* ---------- Nav ---------- */
    .nav {
      position: sticky; top: 0; z-index: 100;
      backdrop-filter: blur(14px);
      background: rgba(10, 12, 18, 0.6);
      border-bottom: 1px solid transparent;
      transition: border-color 240ms ease, background 240ms ease;
    }
    .nav.scrolled { border-bottom-color: var(--border-subtle); background: rgba(10, 12, 18, 0.82); }
    .nav-inner {
      max-width: var(--maxw); margin: 0 auto; padding: 14px 24px;
      display: flex; align-items: center; gap: 28px;
    }
    .brand {
      font-family: var(--font-display); font-weight: 600; font-size: 19px;
      color: var(--text-primary); text-decoration: none; letter-spacing: -0.02em;
      display: inline-flex; align-items: center; gap: 9px;
    }
    .brand-dot {
      width: 11px; height: 11px; border-radius: 50%;
      background: var(--accent); box-shadow: 0 0 0 4px var(--accent-muted);
    }
    .nav-links { margin-left: auto; display: flex; gap: 26px; }
    .nav-links a {
      color: var(--text-secondary); text-decoration: none; font-size: 14.5px; font-weight: 450;
      transition: color 160ms ease;
    }
    .nav-links a:hover { color: var(--text-primary); }
    .nav-gh {
      display: inline-flex; align-items: center; gap: 8px;
      color: var(--text-primary); text-decoration: none; font-size: 14px; font-weight: 500;
      padding: 8px 14px; border: 1px solid var(--border-medium); border-radius: 999px;
      transition: background 160ms ease, border-color 160ms ease;
    }
    .nav-gh:hover { background: rgba(255, 255, 255, 0.05); border-color: var(--border-medium); }
    @media (max-width: 800px) {
      .nav-links { display: none; }
      .nav-gh span { display: none; }
      .nav-gh { margin-left: auto; padding: 9px; }
    }

    /* ---------- Shared ---------- */
    .eyebrow {
      font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--accent); margin: 0 0 14px;
    }
    h1, h2, h3 { font-family: var(--font-display); color: var(--text-primary); letter-spacing: -0.025em; }
    .sec-head { max-width: 720px; margin: 0 0 56px; }
    .sec-head h2 { font-size: clamp(28px, 4vw, 42px); line-height: 1.08; margin: 0 0 18px; font-weight: 600; }
    .sec-lead { font-size: clamp(16px, 1.6vw, 18px); line-height: 1.6; color: var(--text-secondary); margin: 0; }
    section { padding-block: clamp(72px, 11vw, 132px); }

