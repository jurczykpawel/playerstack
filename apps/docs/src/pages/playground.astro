---
import Base from "../layouts/Base.astro";
---

<Base title="Playground — Playerstack">
  <main>
    <header>
      <a href="/" class="back">← Playerstack</a>
      <h1>Live playground</h1>
      <p class="lead">
        Pick a preset to see what's possible, then tweak the config and copy the embed.
      </p>
    </header>

    <div class="presets" id="presets">
      <button type="button" data-preset="minimal">
        <strong>1. Minimal YouTube</strong>
        <span>Default Media Chrome UI, no plugins. Just paste a YT URL.</span>
      </button>
      <button type="button" data-preset="gdpr">
        <strong>2. GDPR + LCP</strong>
        <span>Click-to-load. Zero YT cookies until interaction.</span>
      </button>
      <button type="button" data-preset="branded">
        <strong>3. Branded purple</strong>
        <span>Custom accent color + custom poster. No click-to-load.</span>
      </button>
      <button type="button" data-preset="sales">
        <strong>4. Sales funnel</strong>
        <span>Click-to-load + end-of-video CTA "Buy now" + replay button.</span>
      </button>
      <button type="button" data-preset="vimeo">
        <strong>5. Vimeo source</strong>
        <span>Same plugin, Vimeo URL. Auto-detected.</span>
      </button>
      <button type="button" data-preset="mp4-cta">
        <strong>6. MP4 with CTA</strong>
        <span>Self-hosted MP4 file with end-card linking to a course.</span>
      </button>
      <button type="button" data-preset="chapters">
        <strong>7. Video chapters</strong>
        <span>Clickable chapter list under the player, active chapter highlights as time progresses.</span>
      </button>
      <button type="button" data-preset="email-gate">
        <strong>8. Email gate</strong>
        <span>Lead capture form blocks playback until visitor submits email. Saved in localStorage.</span>
      </button>
      <button type="button" data-preset="action-bar">
        <strong>9. Mid-video CTA bar</strong>
        <span>Banner appears 5s in with a button. Dismissible. Emits action-bar:click event.</span>
      </button>
      <button type="button" data-preset="resume">
        <strong>10. Resume watching</strong>
        <span>Saved-position plugin remembers where you left off via localStorage.</span>
      </button>
      <button type="button" data-preset="autopreview">
        <strong>11. Autopreview</strong>
        <span>Muted autoplay when player is in viewport, pause when scrolled out.</span>
      </button>
      <button type="button" data-preset="sticky">
        <strong>12. Sticky on scroll</strong>
        <span>Pin to corner when you scroll past while it's playing. Scroll the page to see it.</span>
      </button>
      <button type="button" data-preset="focus-mode">
        <strong>13. Focus mode</strong>
        <span>Auto-pause when you switch tabs. Switch back, click play to resume.</span>
      </button>
      <button type="button" data-preset="yt-subscribe">
        <strong>14. YT Subscribe bar</strong>
        <span>Subscribe button below the player linking to a YouTube channel.</span>
      </button>
      <button type="button" data-preset="minimal-controls">
        <strong>15. Hide controls</strong>
        <span>Whitelist play+progress only. Hide volume, fullscreen, speed, etc.</span>
      </button>
      <button type="button" data-preset="analytics">
        <strong>16. Analytics tracking</strong>
        <span>Forwards every cta:click / play / pause / ended to a beacon endpoint.</span>
      </button>
      <button type="button" data-preset="full-stack">
        <strong>17. Everything on</strong>
        <span>All marketing + e-learning + privacy plugins enabled at once.</span>
      </button>
    </div>

    <div class="grid">
      <form id="cfg-form">
        <label>
          <span>Source URL</span>
          <input id="cfg-src" type="url" value="https://youtu.be/dQw4w9WgXcQ" />
        </label>
        <label>
          <span>Title</span>
          <input id="cfg-title" type="text" value="Demo" />
        </label>
        <label>
          <span>Poster URL</span>
          <input id="cfg-poster" type="url" placeholder="https://…/poster.jpg" />
        </label>
        <label>
          <span>Accent color</span>
          <input id="cfg-accent" type="color" value="#008aff" />
        </label>
        <label class="checkbox">
          <input id="cfg-clicktoload" type="checkbox" checked />
          <span>Click-to-load (LCP + GDPR)</span>
        </label>
        <label>
          <span>CTA title at end</span>
          <input id="cfg-ctatitle" type="text" placeholder="Thanks for watching!" />
        </label>
        <label>
          <span>CTA button label</span>
          <input id="cfg-btnlabel" type="text" placeholder="Buy now" />
        </label>
        <label>
          <span>CTA button URL</span>
          <input id="cfg-btnurl" type="url" placeholder="https://…" />
        </label>
      </form>

      <div class="preview">
        <div class="player-wrap" id="preview-host"></div>
        <div class="preset-tip" id="preset-tip" hidden>
          <strong class="preset-tip-title"></strong>
          <ol class="preset-tip-steps"></ol>
        </div>
        <h3>Embed snippet</h3>
        <pre id="snippet"><code></code></pre>
        <button id="copy-btn" type="button">Copy</button>
      </div>
    </div>
  </main>

  <!-- Media Chrome ships its own UI as Web Components (shadow DOM); no external CSS needed. -->
  <!-- Local bundle in dev (apps/docs/public/playerstack.min.js); jsDelivr in prod build -->
  <script src="/playerstack.min.js" is:inline></script>
  <script>
    function readForm() {
      return {
        src: (document.getElementById("cfg-src") as HTMLInputElement).value,
        title: (document.getElementById("cfg-title") as HTMLInputElement).value,
        poster: (document.getElementById("cfg-poster") as HTMLInputElement).value,
        accent: (document.getElementById("cfg-accent") as HTMLInputElement).value,
        clickToLoad: (document.getElementById("cfg-clicktoload") as HTMLInputElement).checked,
        ctaTitle: (document.getElementById("cfg-ctatitle") as HTMLInputElement).value,
        btnLabel: (document.getElementById("cfg-btnlabel") as HTMLInputElement).value,
        btnUrl: (document.getElementById("cfg-btnurl") as HTMLInputElement).value,
      };
    }

    let activePresetExtra: Record<string, unknown> = {};

    function buildConfig(state: ReturnType<typeof readForm>) {
      const cfg: Record<string, unknown> = { ...activePresetExtra };
      if (state.accent) cfg.controls = { ...((cfg.controls as Record<string, unknown>) ?? {}), accent: state.accent };
      if (state.clickToLoad) cfg.brandedThumb = { enabled: true, clickToLoad: true, ...((cfg.brandedThumb as Record<string, unknown>) ?? {}) };
      const cta: Record<string, unknown> = {};
      if (state.ctaTitle) cta.title = state.ctaTitle;
      if (state.btnLabel && state.btnUrl) cta.button = { label: state.btnLabel, url: state.btnUrl };
      if (Object.keys(cta).length > 0) cfg.ctaEnd = { enabled: true, ...cta };
      return cfg;
    }

    function escapeAttr(s: string) { return s.replace(/"/g, "&quot;"); }

    function render() {
      const state = readForm();
      const cfg = buildConfig(state);
      const cfgJson = JSON.stringify(cfg);

      const host = document.getElementById("preview-host");
      if (host) {
        host.innerHTML = "";
        const el = document.createElement("player-stack");
        el.setAttribute("src", state.src);
        if (state.title) el.setAttribute("title", state.title);
        if (state.poster) el.setAttribute("poster", state.poster);
        if (cfgJson !== "{}") el.setAttribute("data-config", cfgJson);
        host.appendChild(el);
      }

      const snippet = document.querySelector("#snippet code");
      if (snippet) {
        const attrs = [
          `src="${escapeAttr(state.src)}"`,
          state.title ? `title="${escapeAttr(state.title)}"` : "",
          state.poster ? `poster="${escapeAttr(state.poster)}"` : "",
          cfgJson !== "{}" ? `data-config='${cfgJson}'` : "",
        ].filter(Boolean).join("\n  ");

        snippet.textContent = '<script src="https://cdn.jsdelivr.net/npm/playerstack@0.1.0/dist/playerstack.min.js" defer><' + '/script>\n\n<player-stack\n  ' + attrs + '>\n</player-stack>';
      }
    }

    document.querySelectorAll<HTMLInputElement>("#cfg-form input").forEach((input) => {
      const onUserEdit = () => {
        // user is hand-tweaking — drop preset's deep config so the form fields stay authoritative
        activePresetExtra = {};
        document.querySelectorAll("#presets button.active").forEach((b) => b.classList.remove("active"));
        renderTip(null);
        render();
      };
      input.addEventListener("input", onUserEdit);
      input.addEventListener("change", onUserEdit);
    });

    document.getElementById("copy-btn")?.addEventListener("click", () => {
      const txt = document.querySelector("#snippet code")?.textContent ?? "";
      navigator.clipboard.writeText(txt);
    });

    interface Preset {
      src: string;
      title: string;
      poster: string;
      accent: string;
      clickToLoad: boolean;
      ctaTitle: string;
      btnLabel: string;
      btnUrl: string;
      /** Extra config keys merged into the embed (chapters, emailGate, sticky, etc.) */
      extra?: Record<string, unknown>;
      /** Headline shown in the "what to expect" panel */
      tipTitle?: string;
      /** Step-by-step instructions for what to actually try */
      tipSteps?: string[];
    }

