        tipSteps: [
          "Player is gated by clickToLoad — click the play overlay first.",
          "Below the player you see 3 chapter buttons.",
          "Wait 10s into playback → action-bar 'Try the playground →' slides in.",
          "Scroll down while playing → sticky pin to corner.",
          "Switch tab and back → focus-mode pauses.",
          "Pause + reload → saved-position resumes you where you left off.",
          "Watch to end → CTA-end card 'Liked it? Get the course' shows.",
          "Open DevTools console → analytics is set to provider: 'gtag' (no gtag loaded so it's a no-op, but listeners are attached).",
        ],
      },
    };

    function applyPreset(preset: Preset) {
      const set = (id: string, value: string) => {
        const el = document.getElementById(id) as HTMLInputElement | null;
        if (el) el.value = value;
      };
      const setCheck = (id: string, value: boolean) => {
        const el = document.getElementById(id) as HTMLInputElement | null;
        if (el) el.checked = value;
      };

      set("cfg-src", preset.src);
      set("cfg-title", preset.title);
      set("cfg-poster", preset.poster);
      set("cfg-accent", preset.accent);
      setCheck("cfg-clicktoload", preset.clickToLoad);
      set("cfg-ctatitle", preset.ctaTitle);
      set("cfg-btnlabel", preset.btnLabel);
      set("cfg-btnurl", preset.btnUrl);
      activePresetExtra = preset.extra ?? {};
      renderTip(preset);
      render();
    }

    function renderTip(preset: Preset | null) {
      const tip = document.getElementById("preset-tip") as HTMLElement | null;
      if (!tip) return;
      if (!preset || !preset.tipTitle) {
        tip.hidden = true;
        return;
      }
      tip.hidden = false;
      const titleEl = tip.querySelector(".preset-tip-title") as HTMLElement;
      titleEl.textContent = `What to look for: ${preset.tipTitle}`;
      const list = tip.querySelector(".preset-tip-steps") as HTMLOListElement;
      list.innerHTML = "";
      for (const step of preset.tipSteps ?? []) {
        const li = document.createElement("li");
        li.textContent = step;
        list.appendChild(li);
      }
    }

    document.querySelectorAll<HTMLButtonElement>("#presets button").forEach((btn) => {
      btn.addEventListener("click", () => {
        const key = btn.dataset.preset ?? "";
        const preset = PRESETS[key];
        if (!preset) return;
        document
          .querySelectorAll("#presets button")
          .forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        applyPreset(preset);
      });
    });

    render();
  </script>
</Base>

