    function applyPreset(preset: Preset) {
      const set = (id: string, value: string) => {
        const el = document.getElementById(id) as HTMLInputElement | null;
        if (el) el.value = value;
      };
      const setCheck = (id: string, value: boolean) => {
        const el = document.getElementById(id) as HTMLInputElement | null;
        if (el) el.checked = value;
      };

      set("cfg-src", preset.src);
      set("cfg-title", preset.title);
      set("cfg-poster", preset.poster);
      set("cfg-accent", preset.accent);
      setCheck("cfg-clicktoload", preset.clickToLoad);
      set("cfg-ctatitle", preset.ctaTitle);
      set("cfg-btnlabel", preset.btnLabel);
      set("cfg-btnurl", preset.btnUrl);
      activePresetExtra = preset.extra ?? {};
      renderTip(preset);
      render();
    }

    function renderTip(preset: Preset | null) {
      const tip = document.getElementById("preset-tip") as HTMLElement | null;
      if (!tip) return;
      if (!preset || !preset.tipTitle) {
        tip.hidden = true;
        return;
      }
      tip.hidden = false;
      const titleEl = tip.querySelector(".preset-tip-title") as HTMLElement;
      titleEl.textContent = `What to look for: ${preset.tipTitle}`;
      const list = tip.querySelector(".preset-tip-steps") as HTMLOListElement;
      list.innerHTML = "";
      for (const step of preset.tipSteps ?? []) {
        const li = document.createElement("li");
        li.textContent = step;
        list.appendChild(li);
      }
    }

    document.querySelectorAll<HTMLButtonElement>("#presets button").forEach((btn) => {
      btn.addEventListener("click", () => {
        const key = btn.dataset.preset ?? "";
        const preset = PRESETS[key];
        if (!preset) return;
        document
          .querySelectorAll("#presets button")
          .forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        applyPreset(preset);
      });
    });

    render();
  </script>
</Base>

<style>
  main { max-width: 1100px; margin: 0 auto; padding: 32px 24px 96px; }
  .back { color: var(--muted); text-decoration: none; font-size: 14px; }
  h1 { font-size: 32px; margin: 12px 0 4px; }
  .lead { color: var(--muted); margin: 0 0 24px; }

  .presets {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin: 0 0 32px;
  }
  @media (max-width: 800px) {
    .presets { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 500px) {
    .presets { grid-template-columns: 1fr; }
  }
  .presets button {
    display: grid;
    gap: 4px;
    text-align: left;
    padding: 12px 14px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--fg);
    cursor: pointer;
    font: inherit;
    transition: background 0.15s, border-color 0.15s;
  }
  .presets button:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(0, 138, 255, 0.4);
  }
  .presets button.active {
    background: rgba(0, 138, 255, 0.1);
    border-color: var(--accent);
  }
  .presets button strong {
    font-size: 14px;
    font-weight: 600;
  }
  .presets button span {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.4;
  }

  .grid { display: grid; grid-template-columns: 320px 1fr; gap: 32px; }
  @media (max-width: 800px) {
    .grid { grid-template-columns: 1fr; }
  }
  form { display: grid; gap: 12px; }
  label { display: grid; gap: 4px; font-size: 13px; color: var(--muted); }
  label.checkbox { display: flex; flex-direction: row; align-items: center; gap: 8px; }
  input[type="text"], input[type="url"] {
    padding: 8px 10px;
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--fg);
    font-size: 14px;
  }
  input[type="color"] { width: 100%; height: 36px; border: 1px solid var(--border); border-radius: 6px; background: transparent; }
  /* No aspect-ratio / overflow here — <player-stack> sets its own 16:9 frame
     in core's DEFAULT_STYLES. Wrapping it in another aspect-ratio container
     would clip plugins that mount as siblings (chapters, yt-subscribe). */
  .player-wrap { display: block; }
  .preset-tip {
    margin-top: 16px;
    padding: 14px 16px;
    background: rgba(0, 138, 255, 0.06);
    border: 1px solid rgba(0, 138, 255, 0.25);
    border-radius: 8px;
    font-size: 13px;
    line-height: 1.5;
  }
  .preset-tip .preset-tip-title {
    display: block;
    font-size: 14px;
    color: var(--accent);
    margin-bottom: 6px;
  }
  .preset-tip ol {
    margin: 0;
    padding-left: 20px;
    color: var(--fg);
  }
  .preset-tip li {
    margin: 4px 0;
  }
  pre { white-space: pre-wrap; word-break: break-all; }
  #copy-btn {
    margin-top: 8px;
    padding: 8px 16px;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 500;
  }

</style>
