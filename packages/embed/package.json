{
  "name": "playerstack",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "Embeddable video player. Drop one script tag, embed YouTube/Vimeo/MP4/HLS with branding and CTAs. Apache-2.0, plugin-first.",
  "type": "module",
  "main": "./dist/playerstack.cjs",
  "module": "./dist/playerstack.esm.js",
  "browser": "./dist/playerstack.min.js",
  "unpkg": "./dist/playerstack.min.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "browser": "./dist/playerstack.min.js",
      "import": "./dist/playerstack.esm.js",
      "require": "./dist/playerstack.cjs"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@playerstack/core": "workspace:*",
    "@playerstack/plugin-sources": "workspace:*",
    "@playerstack/plugin-controls-policy": "workspace:*",
    "@playerstack/plugin-autopreview": "workspace:*",
    "@playerstack/plugin-branded-thumb": "workspace:*",
    "@playerstack/plugin-cta-end": "workspace:*",
    "@playerstack/plugin-chapters": "workspace:*",
    "@playerstack/plugin-action-bar": "workspace:*",
    "@playerstack/plugin-email-gate": "workspace:*",
    "@playerstack/plugin-saved-position": "workspace:*",
    "@playerstack/plugin-sticky": "workspace:*",
    "@playerstack/plugin-focus-mode": "workspace:*",
    "@playerstack/plugin-analytics": "workspace:*",
    "@playerstack/plugin-yt-subscribe": "workspace:*",
    "@playerstack/plugin-watermark": "workspace:*",
    "@playerstack/plugin-custom-css": "workspace:*",
    "@playerstack/plugin-intro-card": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
